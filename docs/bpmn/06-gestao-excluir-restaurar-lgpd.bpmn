      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="apaga_di" bpmnElement="apaga">
        <dc:Bounds x="1380" y="982" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="junta_di" bpmnElement="junta" isMarkerVisible="true">
        <dc:Bounds x="1625" y="890" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1523" y="866" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="atualiza_di" bpmnElement="atualiza">
        <dc:Bounds x="1770" y="522" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fim_di" bpmnElement="fim">
        <dc:Bounds x="2022" y="547" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1985" y="589" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Seta_1_di" bpmnElement="Seta_1">
        <di:waypoint x="303" y="215" />
        <di:waypoint x="455" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_2_di" bpmnElement="Seta_2">
        <di:waypoint x="480" y="190" />
        <di:waypoint x="480" y="105" />
        <di:waypoint x="600" y="105" />
        <bpmndi:BPMNLabel><dc:Bounds x="488" y="85" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_3_di" bpmnElement="Seta_3">
        <di:waypoint x="480" y="240" />
        <di:waypoint x="480" y="915" />
        <di:waypoint x="795" y="915" />
        <bpmndi:BPMNLabel><dc:Bounds x="488" y="895" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_4_di" bpmnElement="Seta_4">
        <di:waypoint x="480" y="240" />
