        <di:waypoint x="600" y="325" />
        <bpmndi:BPMNLabel><dc:Bounds x="488" y="305" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_5_di" bpmnElement="Seta_5">
        <di:waypoint x="750" y="105" />
        <di:waypoint x="820" y="105" />
        <di:waypoint x="820" y="805" />
        <di:waypoint x="845" y="805" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_6_di" bpmnElement="Seta_6">
