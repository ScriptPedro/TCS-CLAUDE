<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definicoes_gestao_cadastro_edicao" targetNamespace="https://github.com/ScriptPedro/TCS-CLAUDE/docs/bpmn" exporter="Assessor de Investimentos Virtual" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracao_gestao_cadastro_edicao">
    <bpmn:participant id="Participante_gestao_cadastro_edicao" name="Gerenciar usuários (só administradores)" processRef="Processo_gestao_cadastro_edicao" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_gestao_cadastro_edicao" name="05 — Gerenciar usuários: cadastrar e editar" isExecutable="false">
    <bpmn:documentation>Rotas protegidas por exigir_admin. Um administrador não pode tirar o próprio acesso de administrador.</bpmn:documentation>
    <bpmn:laneSet id="Raias_gestao_cadastro_edicao">
      <bpmn:lane id="Raia_gestao_cadastro_edicao_0" name="Administrador">
        <bpmn:flowNodeRef>ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>acao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>preenche</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>altera</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_gestao_cadastro_edicao_1" name="Aplicativo (front React)">
        <bpmn:flowNodeRef>fim_403</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mostra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>erro_novo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>erro_ed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atualiza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_gestao_cadastro_edicao_2" name="API (FastAPI) + PostgreSQL">
        <bpmn:flowNodeRef>admin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_admin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valida_novo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok_novo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ficha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valida_ed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok_ed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grava</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>junta</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ini" name="Abre Conta → Gerenciar usuários">
      <bpmn:outgoing>Seta_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="admin" name="Confere se é administrador">
      <bpmn:incoming>Seta_1</bpmn:incoming>
      <bpmn:outgoing>Seta_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="e_admin" name="É admin?">
      <bpmn:incoming>Seta_2</bpmn:incoming>
      <bpmn:outgoing>Seta_3</bpmn:outgoing>
      <bpmn:outgoing>Seta_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="fim_403" name="403: acesso negado">
      <bpmn:incoming>Seta_3</bpmn:incoming>
      <bpmn:errorEventDefinition id="Erro_fim_403" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="lista" name="Lista as contas (busca; CPF mascarado)">
      <bpmn:incoming>Seta_4</bpmn:incoming>
      <bpmn:outgoing>Seta_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="mostra" name="Mostra a lista">
      <bpmn:incoming>Seta_5</bpmn:incoming>
      <bpmn:outgoing>Seta_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="acao" name="Ação?">
      <bpmn:incoming>Seta_6</bpmn:incoming>
      <bpmn:outgoing>Seta_7</bpmn:outgoing>
      <bpmn:outgoing>Seta_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="preenche" name="Preenche os dados e o tipo (usuário ou admin)">
      <bpmn:incoming>Seta_7</bpmn:incoming>
      <bpmn:incoming>Seta_12</bpmn:incoming>
      <bpmn:outgoing>Seta_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="valida_novo" name="Valida os campos e confere CPF/e-mail únicos">
      <bpmn:incoming>Seta_9</bpmn:incoming>
      <bpmn:outgoing>Seta_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ok_novo" name="Ok?">
      <bpmn:incoming>Seta_10</bpmn:incoming>
      <bpmn:outgoing>Seta_11</bpmn:outgoing>
      <bpmn:outgoing>Seta_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="erro_novo" name="Mostra o erro de cada campo">
      <bpmn:incoming>Seta_11</bpmn:incoming>
      <bpmn:outgoing>Seta_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="cria" name="Cria a conta">
      <bpmn:incoming>Seta_13</bpmn:incoming>
      <bpmn:outgoing>Seta_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ficha" name="Abre a ficha (CPF completo)">
      <bpmn:incoming>Seta_8</bpmn:incoming>
      <bpmn:outgoing>Seta_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="altera" name="Altera nome, e-mail, idade, tipo ou senha">
      <bpmn:incoming>Seta_15</bpmn:incoming>
      <bpmn:incoming>Seta_19</bpmn:incoming>
      <bpmn:outgoing>Seta_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="valida_ed" name="Valida (admin não se rebaixa; excluída: restaure antes)">
      <bpmn:incoming>Seta_16</bpmn:incoming>
      <bpmn:outgoing>Seta_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ok_ed" name="Ok?">
      <bpmn:incoming>Seta_17</bpmn:incoming>
      <bpmn:outgoing>Seta_18</bpmn:outgoing>
      <bpmn:outgoing>Seta_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="erro_ed" name="Mostra o erro">
      <bpmn:incoming>Seta_18</bpmn:incoming>
      <bpmn:outgoing>Seta_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="grava" name="Grava (senha nova encerra as sessões)">
      <bpmn:incoming>Seta_20</bpmn:incoming>
      <bpmn:outgoing>Seta_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="junta" name="">
      <bpmn:incoming>Seta_14</bpmn:incoming>
      <bpmn:incoming>Seta_21</bpmn:incoming>
      <bpmn:outgoing>Seta_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="atualiza" name="Mostra o aviso e a lista atualizada">
      <bpmn:incoming>Seta_22</bpmn:incoming>
      <bpmn:outgoing>Seta_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fim" name="Conta cadastrada ou atualizada">
      <bpmn:incoming>Seta_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seta_1" sourceRef="ini" targetRef="admin" />
    <bpmn:sequenceFlow id="Seta_2" sourceRef="admin" targetRef="e_admin" />
    <bpmn:sequenceFlow id="Seta_3" name="não" sourceRef="e_admin" targetRef="fim_403" />
    <bpmn:sequenceFlow id="Seta_4" name="sim" sourceRef="e_admin" targetRef="lista" />
    <bpmn:sequenceFlow id="Seta_5" sourceRef="lista" targetRef="mostra" />
    <bpmn:sequenceFlow id="Seta_6" sourceRef="mostra" targetRef="acao" />
    <bpmn:sequenceFlow id="Seta_7" name="cadastrar" sourceRef="acao" targetRef="preenche" />
    <bpmn:sequenceFlow id="Seta_8" name="editar" sourceRef="acao" targetRef="ficha" />
    <bpmn:sequenceFlow id="Seta_9" sourceRef="preenche" targetRef="valida_novo" />
    <bpmn:sequenceFlow id="Seta_10" sourceRef="valida_novo" targetRef="ok_novo" />
    <bpmn:sequenceFlow id="Seta_11" name="não" sourceRef="ok_novo" targetRef="erro_novo" />
    <bpmn:sequenceFlow id="Seta_12" sourceRef="erro_novo" targetRef="preenche" />
    <bpmn:sequenceFlow id="Seta_13" name="sim" sourceRef="ok_novo" targetRef="cria" />
    <bpmn:sequenceFlow id="Seta_14" sourceRef="cria" targetRef="junta" />
    <bpmn:sequenceFlow id="Seta_15" sourceRef="ficha" targetRef="altera" />
    <bpmn:sequenceFlow id="Seta_16" sourceRef="altera" targetRef="valida_ed" />
    <bpmn:sequenceFlow id="Seta_17" sourceRef="valida_ed" targetRef="ok_ed" />
    <bpmn:sequenceFlow id="Seta_18" name="não" sourceRef="ok_ed" targetRef="erro_ed" />
    <bpmn:sequenceFlow id="Seta_19" sourceRef="erro_ed" targetRef="altera" />
    <bpmn:sequenceFlow id="Seta_20" name="sim" sourceRef="ok_ed" targetRef="grava" />
    <bpmn:sequenceFlow id="Seta_21" sourceRef="grava" targetRef="junta" />
    <bpmn:sequenceFlow id="Seta_22" sourceRef="junta" targetRef="atualiza" />
    <bpmn:sequenceFlow id="Seta_23" sourceRef="atualiza" targetRef="fim" />
  </bpmn:process>
