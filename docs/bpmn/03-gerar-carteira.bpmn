<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definicoes_recomendacao" targetNamespace="https://github.com/ScriptPedro/TCS-CLAUDE/docs/bpmn" exporter="Assessor de Investimentos Virtual" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracao_recomendacao">
    <bpmn:participant id="Participante_recomendacao" name="Gerar a carteira sugerida" processRef="Processo_recomendacao" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_recomendacao" name="03 — Gerar a carteira (recomendação)" isExecutable="false">
    <bpmn:documentation>Modelos aprendidos (K-Means, LightGBM, SHAP) e regras de negócio (suitability) separados: o perfil de risco define as faixas e o modelo só posiciona dentro delas.</bpmn:documentation>
    <bpmn:laneSet id="Raias_recomendacao">
      <bpmn:lane id="Raia_recomendacao_0" name="Cliente">
        <bpmn:flowNodeRef>ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>responde</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ajustar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_recomendacao_1" name="Aplicativo (front React)">
        <bpmn:flowNodeRef>carrega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>envia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>expirou</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_expirou</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>falta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mostra</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_recomendacao_2" name="API (FastAPI) + PostgreSQL">
        <bpmn:flowNodeRef>sessao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valida_sessao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>valida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>completas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>modelos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_503</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>salva</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_recomendacao_3" name="Motor: modelos de IA + regras (src.advisor, src.portfolio)">
        <bpmn:flowNodeRef>traduz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>modelo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>perfil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>protecao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>modo_protecao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>junta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>aloca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>explica</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ini" name="Toca em 'Descobrir minha carteira'">
      <bpmn:outgoing>Seta_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="carrega" name="Carrega o questionário (GET /api/questionario)">
      <bpmn:incoming>Seta_1</bpmn:incoming>
      <bpmn:outgoing>Seta_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="responde" name="Responde 14 perguntas em 4 etapas">
      <bpmn:incoming>Seta_2</bpmn:incoming>
      <bpmn:incoming>Seta_11</bpmn:incoming>
      <bpmn:incoming>Seta_26</bpmn:incoming>
      <bpmn:outgoing>Seta_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="envia" name="Guarda o rascunho no aparelho e envia com o token">
      <bpmn:incoming>Seta_3</bpmn:incoming>
      <bpmn:outgoing>Seta_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="sessao" name="Confere a sessão">
      <bpmn:incoming>Seta_4</bpmn:incoming>
      <bpmn:outgoing>Seta_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="valida_sessao" name="Sessão válida?">
      <bpmn:incoming>Seta_5</bpmn:incoming>
      <bpmn:outgoing>Seta_6</bpmn:outgoing>
      <bpmn:outgoing>Seta_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="expirou" name="Volta ao login com aviso">
      <bpmn:incoming>Seta_6</bpmn:incoming>
      <bpmn:outgoing>Seta_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fim_expirou" name="Sessão expirada">
      <bpmn:incoming>Seta_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="valida" name="Valida as respostas (faixas, idade 18–100)">
      <bpmn:incoming>Seta_8</bpmn:incoming>
      <bpmn:outgoing>Seta_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="completas" name="Respostas válidas?">
      <bpmn:incoming>Seta_9</bpmn:incoming>
      <bpmn:outgoing>Seta_10</bpmn:outgoing>
      <bpmn:outgoing>Seta_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="falta" name="Mostra o que falta responder">
      <bpmn:incoming>Seta_10</bpmn:incoming>
      <bpmn:outgoing>Seta_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="modelos" name="Modelos carregados?">
      <bpmn:incoming>Seta_12</bpmn:incoming>
      <bpmn:outgoing>Seta_13</bpmn:outgoing>
      <bpmn:outgoing>Seta_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="fim_503" name="503: modelos ausentes">
      <bpmn:incoming>Seta_13</bpmn:incoming>
      <bpmn:errorEventDefinition id="Erro_fim_503" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="traduz" name="Traduz as respostas em atributos do modelo">
      <bpmn:documentation>Renda brasileira → quintil → renda espanhola equivalente pela posição relativa (D3).</bpmn:documentation>
      <bpmn:incoming>Seta_14</bpmn:incoming>
      <bpmn:outgoing>Seta_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="modelo" name="Segmento (K-Means) e chance por produto (LightGBM + SHAP)">
      <bpmn:incoming>Seta_15</bpmn:incoming>
      <bpmn:outgoing>Seta_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="perfil" name="Perfil de risco por pontos, com travas (suitability)">
      <bpmn:incoming>Seta_16</bpmn:incoming>
      <bpmn:outgoing>Seta_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="protecao" name="Dívida cara ou sem reserva?">
      <bpmn:incoming>Seta_17</bpmn:incoming>
      <bpmn:outgoing>Seta_18</bpmn:outgoing>
      <bpmn:outgoing>Seta_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="modo_protecao" name="Modo proteção: zera ações e multimercado">
      <bpmn:incoming>Seta_18</bpmn:incoming>
      <bpmn:outgoing>Seta_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="junta" name="">
      <bpmn:incoming>Seta_19</bpmn:incoming>
      <bpmn:incoming>Seta_20</bpmn:incoming>
      <bpmn:outgoing>Seta_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="aloca" name="Aloca dentro das faixas do perfil">
      <bpmn:documentation>O perfil define o mínimo e o máximo de cada classe; a afinidade do modelo (misturada 50/50 com o Raio X ANBIMA, se houver) só posiciona dentro da faixa.</bpmn:documentation>
      <bpmn:incoming>Seta_21</bpmn:incoming>
      <bpmn:outgoing>Seta_22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="explica" name="Escreve a explicação em linguagem simples">
      <bpmn:incoming>Seta_22</bpmn:incoming>
      <bpmn:outgoing>Seta_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="salva" name="Salva a recomendação ligada ao cliente (JSONB)">
      <bpmn:incoming>Seta_23</bpmn:incoming>
      <bpmn:outgoing>Seta_24</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Assoc_recomendacao_0"><bpmn:targetRef>bd</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="bd" name="PostgreSQL: recomendacoes" />
    <bpmn:task id="mostra" name="Mostra a carteira, os motivos e os próximos passos">
      <bpmn:incoming>Seta_24</bpmn:incoming>
      <bpmn:outgoing>Seta_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ajustar" name="Quer ajustar as respostas?">
      <bpmn:incoming>Seta_25</bpmn:incoming>
      <bpmn:outgoing>Seta_26</bpmn:outgoing>
      <bpmn:outgoing>Seta_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="fim" name="Carteira sugerida">
      <bpmn:incoming>Seta_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seta_1" sourceRef="ini" targetRef="carrega" />
    <bpmn:sequenceFlow id="Seta_2" sourceRef="carrega" targetRef="responde" />
    <bpmn:sequenceFlow id="Seta_3" sourceRef="responde" targetRef="envia" />
    <bpmn:sequenceFlow id="Seta_4" sourceRef="envia" targetRef="sessao" />
    <bpmn:sequenceFlow id="Seta_5" sourceRef="sessao" targetRef="valida_sessao" />
    <bpmn:sequenceFlow id="Seta_6" name="não" sourceRef="valida_sessao" targetRef="expirou" />
    <bpmn:sequenceFlow id="Seta_7" sourceRef="expirou" targetRef="fim_expirou" />
    <bpmn:sequenceFlow id="Seta_8" name="sim" sourceRef="valida_sessao" targetRef="valida" />
    <bpmn:sequenceFlow id="Seta_9" sourceRef="valida" targetRef="completas" />
    <bpmn:sequenceFlow id="Seta_10" name="não" sourceRef="completas" targetRef="falta" />
    <bpmn:sequenceFlow id="Seta_11" sourceRef="falta" targetRef="responde" />
    <bpmn:sequenceFlow id="Seta_12" name="sim" sourceRef="completas" targetRef="modelos" />
    <bpmn:sequenceFlow id="Seta_13" name="não" sourceRef="modelos" targetRef="fim_503" />
    <bpmn:sequenceFlow id="Seta_14" name="sim" sourceRef="modelos" targetRef="traduz" />
    <bpmn:sequenceFlow id="Seta_15" sourceRef="traduz" targetRef="modelo" />
    <bpmn:sequenceFlow id="Seta_16" sourceRef="modelo" targetRef="perfil" />
    <bpmn:sequenceFlow id="Seta_17" sourceRef="perfil" targetRef="protecao" />
    <bpmn:sequenceFlow id="Seta_18" name="sim" sourceRef="protecao" targetRef="modo_protecao" />
    <bpmn:sequenceFlow id="Seta_19" name="não" sourceRef="protecao" targetRef="junta" />
    <bpmn:sequenceFlow id="Seta_20" sourceRef="modo_protecao" targetRef="junta" />
    <bpmn:sequenceFlow id="Seta_21" sourceRef="junta" targetRef="aloca" />
    <bpmn:sequenceFlow id="Seta_22" sourceRef="aloca" targetRef="explica" />
    <bpmn:sequenceFlow id="Seta_23" sourceRef="explica" targetRef="salva" />
    <bpmn:sequenceFlow id="Seta_24" sourceRef="salva" targetRef="mostra" />
    <bpmn:sequenceFlow id="Seta_25" sourceRef="mostra" targetRef="ajustar" />
    <bpmn:sequenceFlow id="Seta_26" name="sim" sourceRef="ajustar" targetRef="responde" />
    <bpmn:sequenceFlow id="Seta_27" name="não" sourceRef="ajustar" targetRef="fim" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_recomendacao">
    <bpmndi:BPMNPlane id="Plano_recomendacao" bpmnElement="Colaboracao_recomendacao">
      <bpmndi:BPMNShape id="Participante_recomendacao_di" bpmnElement="Participante_recomendacao" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="4180" height="890" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Raia_recomendacao_0_di" bpmnElement="Raia_recomendacao_0" isHorizontal="true">
        <dc:Bounds x="150" y="40" width="4150" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Raia_recomendacao_1_di" bpmnElement="Raia_recomendacao_1" isHorizontal="true">
        <dc:Bounds x="150" y="210" width="4150" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Raia_recomendacao_2_di" bpmnElement="Raia_recomendacao_2" isHorizontal="true">
        <dc:Bounds x="150" y="400" width="4150" height="280" />
      </bpmndi:BPMNShape>
