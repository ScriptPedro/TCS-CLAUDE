        <di:waypoint x="1140" y="500" />
        <di:waypoint x="1235" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_6_di" bpmnElement="Seta_6">
        <di:waypoint x="1260" y="475" />
        <di:waypoint x="1260" y="348" />
        <bpmndi:BPMNLabel><dc:Bounds x="1266" y="453" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_7_di" bpmnElement="Seta_7">
        <di:waypoint x="1335" y="305" />
        <di:waypoint x="1437" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_8_di" bpmnElement="Seta_8">
        <di:waypoint x="1285" y="500" />
        <di:waypoint x="1380" y="500" />
