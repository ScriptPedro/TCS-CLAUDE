<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definicoes_minha_conta" targetNamespace="https://github.com/ScriptPedro/TCS-CLAUDE/docs/bpmn" exporter="Assessor de Investimentos Virtual" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracao_minha_conta">
    <bpmn:participant id="Participante_minha_conta" name="Minha conta" processRef="Processo_minha_conta" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_minha_conta" name="04 — Minha conta (dados, senha e saída)" isExecutable="false">
    <bpmn:documentation>A própria pessoa edita nome, e-mail e idade (CPF e tipo não mudam por aqui), troca a senha ou sai.</bpmn:documentation>
    <bpmn:laneSet id="Raias_minha_conta">
      <bpmn:lane id="Raia_minha_conta_0" name="Cliente">
        <bpmn:flowNodeRef>ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>escolha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>altera</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>senhas</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_minha_conta_1" name="Aplicativo (front React)">
        <bpmn:flowNodeRef>mostra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>erro_dados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>atualiza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_dados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>erro_senha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>token</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_senha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sair</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_minha_conta_2" name="API (FastAPI) + PostgreSQL">
        <bpmn:flowNodeRef>put</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok_dados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>grava</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ok_senha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>troca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>encerra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_sair</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ini" name="Abre a aba Conta">
      <bpmn:outgoing>Seta_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="mostra" name="Mostra nome, e-mail, CPF e idade">
      <bpmn:incoming>Seta_1</bpmn:incoming>
      <bpmn:outgoing>Seta_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="escolha" name="O que deseja?">
      <bpmn:incoming>Seta_2</bpmn:incoming>
      <bpmn:outgoing>Seta_3</bpmn:outgoing>
      <bpmn:outgoing>Seta_4</bpmn:outgoing>
      <bpmn:outgoing>Seta_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="altera" name="Altera nome, e-mail ou idade">
      <bpmn:incoming>Seta_3</bpmn:incoming>
      <bpmn:incoming>Seta_9</bpmn:incoming>
      <bpmn:outgoing>Seta_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="put" name="Valida e confere e-mail único (PUT /api/auth/eu)">
      <bpmn:incoming>Seta_6</bpmn:incoming>
      <bpmn:outgoing>Seta_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ok_dados" name="Válido?">
      <bpmn:incoming>Seta_7</bpmn:incoming>
      <bpmn:outgoing>Seta_8</bpmn:outgoing>
      <bpmn:outgoing>Seta_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="erro_dados" name="Mostra o erro no campo">
      <bpmn:incoming>Seta_8</bpmn:incoming>
      <bpmn:outgoing>Seta_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="grava" name="Grava (CPF e tipo não mudam)">
      <bpmn:incoming>Seta_10</bpmn:incoming>
      <bpmn:outgoing>Seta_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="atualiza" name="Atualiza a saudação e a ficha">
      <bpmn:incoming>Seta_11</bpmn:incoming>
      <bpmn:outgoing>Seta_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fim_dados" name="Dados atualizados">
      <bpmn:incoming>Seta_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="senhas" name="Informa a senha atual e a nova (2x)">
      <bpmn:incoming>Seta_4</bpmn:incoming>
      <bpmn:incoming>Seta_16</bpmn:incoming>
      <bpmn:outgoing>Seta_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="post" name="Confere a atual e a regra da nova (POST /api/auth/senha)">
      <bpmn:incoming>Seta_13</bpmn:incoming>
      <bpmn:outgoing>Seta_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ok_senha" name="Aceita?">
      <bpmn:incoming>Seta_14</bpmn:incoming>
      <bpmn:outgoing>Seta_15</bpmn:outgoing>
      <bpmn:outgoing>Seta_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="erro_senha" name="Mostra o erro">
      <bpmn:incoming>Seta_15</bpmn:incoming>
      <bpmn:outgoing>Seta_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="troca" name="Grava o hash, encerra as sessões e abre uma nova">
      <bpmn:incoming>Seta_17</bpmn:incoming>
      <bpmn:outgoing>Seta_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="token" name="Guarda o token novo">
      <bpmn:incoming>Seta_18</bpmn:incoming>
      <bpmn:outgoing>Seta_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="fim_senha" name="Senha trocada; outros aparelhos saem">
      <bpmn:incoming>Seta_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="sair" name="Envia o logout e apaga token e carteira do aparelho">
      <bpmn:incoming>Seta_5</bpmn:incoming>
      <bpmn:outgoing>Seta_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="encerra" name="Encerra a sessão">
      <bpmn:incoming>Seta_20</bpmn:incoming>
      <bpmn:outgoing>Seta_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="fim_sair" name="Fora da conta">
      <bpmn:incoming>Seta_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seta_1" sourceRef="ini" targetRef="mostra" />
    <bpmn:sequenceFlow id="Seta_2" sourceRef="mostra" targetRef="escolha" />
    <bpmn:sequenceFlow id="Seta_3" name="editar dados" sourceRef="escolha" targetRef="altera" />
    <bpmn:sequenceFlow id="Seta_4" name="trocar senha" sourceRef="escolha" targetRef="senhas" />
    <bpmn:sequenceFlow id="Seta_5" name="sair" sourceRef="escolha" targetRef="sair" />
    <bpmn:sequenceFlow id="Seta_6" sourceRef="altera" targetRef="put" />
    <bpmn:sequenceFlow id="Seta_7" sourceRef="put" targetRef="ok_dados" />
    <bpmn:sequenceFlow id="Seta_8" name="não" sourceRef="ok_dados" targetRef="erro_dados" />
    <bpmn:sequenceFlow id="Seta_9" sourceRef="erro_dados" targetRef="altera" />
    <bpmn:sequenceFlow id="Seta_10" name="sim" sourceRef="ok_dados" targetRef="grava" />
    <bpmn:sequenceFlow id="Seta_11" sourceRef="grava" targetRef="atualiza" />
    <bpmn:sequenceFlow id="Seta_12" sourceRef="atualiza" targetRef="fim_dados" />
    <bpmn:sequenceFlow id="Seta_13" sourceRef="senhas" targetRef="post" />
    <bpmn:sequenceFlow id="Seta_14" sourceRef="post" targetRef="ok_senha" />
    <bpmn:sequenceFlow id="Seta_15" name="não" sourceRef="ok_senha" targetRef="erro_senha" />
    <bpmn:sequenceFlow id="Seta_16" sourceRef="erro_senha" targetRef="senhas" />
    <bpmn:sequenceFlow id="Seta_17" name="sim" sourceRef="ok_senha" targetRef="troca" />
    <bpmn:sequenceFlow id="Seta_18" sourceRef="troca" targetRef="token" />
    <bpmn:sequenceFlow id="Seta_19" sourceRef="token" targetRef="fim_senha" />
    <bpmn:sequenceFlow id="Seta_20" sourceRef="sair" targetRef="encerra" />
    <bpmn:sequenceFlow id="Seta_21" sourceRef="encerra" targetRef="fim_sair" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_minha_conta">
    <bpmndi:BPMNPlane id="Plano_minha_conta" bpmnElement="Colaboracao_minha_conta">
