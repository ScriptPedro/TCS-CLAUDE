<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definicoes_visao_geral" targetNamespace="https://github.com/ScriptPedro/TCS-CLAUDE/docs/bpmn" exporter="Assessor de Investimentos Virtual" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracao_visao_geral">
    <bpmn:participant id="Participante_visao_geral" name="Banco Cédula — Assessor de Investimentos Virtual" processRef="Processo_visao_geral" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_visao_geral" name="00 — Visão geral do Banco Cédula com o Assessor" isExecutable="false">
    <bpmn:documentation>Mapa dos processos. Cada subprocesso (call activity) tem o seu próprio diagrama.</bpmn:documentation>
    <bpmn:laneSet id="Raias_visao_geral">
      <bpmn:lane id="Raia_visao_geral_0" name="Pessoa (cliente ou administrador)">
        <bpmn:flowNodeRef>ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>escolha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>continua</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_visao_geral_1" name="Aplicativo + API">
        <bpmn:flowNodeRef>acesso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>carteira</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>conta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gestao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>junta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Raia_visao_geral_2" name="Equipe do projeto">
        <bpmn:flowNodeRef>ini_eq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>treino</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_eq</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ini" name="Abre o app">
      <bpmn:outgoing>Seta_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="acesso" name="Entrar ou criar conta (01, 02)">
      <bpmn:incoming>Seta_1</bpmn:incoming>
      <bpmn:outgoing>Seta_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="escolha" name="O que deseja?">
      <bpmn:incoming>Seta_2</bpmn:incoming>
      <bpmn:incoming>Seta_10</bpmn:incoming>
      <bpmn:outgoing>Seta_3</bpmn:outgoing>
      <bpmn:outgoing>Seta_4</bpmn:outgoing>
      <bpmn:outgoing>Seta_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="carteira" name="Gerar a carteira (03)">
      <bpmn:incoming>Seta_3</bpmn:incoming>
      <bpmn:outgoing>Seta_6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="conta" name="Minha conta (04)">
      <bpmn:incoming>Seta_4</bpmn:incoming>
      <bpmn:outgoing>Seta_7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="gestao" name="Gerenciar usuários, só admin (05, 06)">
      <bpmn:incoming>Seta_5</bpmn:incoming>
      <bpmn:outgoing>Seta_8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="junta" name="">
      <bpmn:incoming>Seta_6</bpmn:incoming>
      <bpmn:incoming>Seta_7</bpmn:incoming>
      <bpmn:incoming>Seta_8</bpmn:incoming>
      <bpmn:outgoing>Seta_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="continua" name="Continua usando?">
      <bpmn:incoming>Seta_9</bpmn:incoming>
      <bpmn:outgoing>Seta_10</bpmn:outgoing>
      <bpmn:outgoing>Seta_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="fim" name="Sai do app">
      <bpmn:incoming>Seta_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ini_eq" name="Dados novos ou mudança no modelo">
      <bpmn:outgoing>Seta_12</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="treino" name="Treinar e publicar os modelos (07)">
      <bpmn:incoming>Seta_12</bpmn:incoming>
      <bpmn:outgoing>Seta_13</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="fim_eq" name="Modelos novos em uso pela API">
      <bpmn:incoming>Seta_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Seta_1" sourceRef="ini" targetRef="acesso" />
    <bpmn:sequenceFlow id="Seta_2" sourceRef="acesso" targetRef="escolha" />
    <bpmn:sequenceFlow id="Seta_3" name="carteira" sourceRef="escolha" targetRef="carteira" />
    <bpmn:sequenceFlow id="Seta_4" name="conta" sourceRef="escolha" targetRef="conta" />
    <bpmn:sequenceFlow id="Seta_5" name="gestão" sourceRef="escolha" targetRef="gestao" />
    <bpmn:sequenceFlow id="Seta_6" sourceRef="carteira" targetRef="junta" />
    <bpmn:sequenceFlow id="Seta_7" sourceRef="conta" targetRef="junta" />
    <bpmn:sequenceFlow id="Seta_8" sourceRef="gestao" targetRef="junta" />
    <bpmn:sequenceFlow id="Seta_9" sourceRef="junta" targetRef="continua" />
    <bpmn:sequenceFlow id="Seta_10" name="sim" sourceRef="continua" targetRef="escolha" />
    <bpmn:sequenceFlow id="Seta_11" name="não" sourceRef="continua" targetRef="fim" />
    <bpmn:sequenceFlow id="Seta_12" sourceRef="ini_eq" targetRef="treino" />
    <bpmn:sequenceFlow id="Seta_13" sourceRef="treino" targetRef="fim_eq" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_visao_geral">
    <bpmndi:BPMNPlane id="Plano_visao_geral" bpmnElement="Colaboracao_visao_geral">
      <bpmndi:BPMNShape id="Participante_visao_geral_di" bpmnElement="Participante_visao_geral" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="1450" height="620" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Raia_visao_geral_0_di" bpmnElement="Raia_visao_geral_0" isHorizontal="true">
        <dc:Bounds x="150" y="40" width="1420" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Raia_visao_geral_1_di" bpmnElement="Raia_visao_geral_1" isHorizontal="true">
        <dc:Bounds x="150" y="210" width="1420" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Raia_visao_geral_2_di" bpmnElement="Raia_visao_geral_2" isHorizontal="true">
        <dc:Bounds x="150" y="510" width="1420" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ini_di" bpmnElement="ini">
        <dc:Bounds x="267" y="107" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="230" y="149" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="acesso_di" bpmnElement="acesso">
        <dc:Bounds x="405" y="317" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="escolha_di" bpmnElement="escolha" isMarkerVisible="true">
        <dc:Bounds x="650" y="100" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="548" y="76" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="carteira_di" bpmnElement="carteira">
        <dc:Bounds x="795" y="222" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="conta_di" bpmnElement="conta">
        <dc:Bounds x="795" y="317" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gestao_di" bpmnElement="gestao">
        <dc:Bounds x="795" y="412" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="junta_di" bpmnElement="junta" isMarkerVisible="true">
        <dc:Bounds x="1040" y="335" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="938" y="311" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="continua_di" bpmnElement="continua" isMarkerVisible="true">
        <dc:Bounds x="1235" y="100" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1133" y="76" width="100" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fim_di" bpmnElement="fim">
        <dc:Bounds x="1437" y="107" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1400" y="149" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ini_eq_di" bpmnElement="ini_eq">
        <dc:Bounds x="462" y="567" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="425" y="609" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="treino_di" bpmnElement="treino">
        <dc:Bounds x="600" y="542" width="150" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fim_eq_di" bpmnElement="fim_eq">
        <dc:Bounds x="852" y="567" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="815" y="609" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Seta_1_di" bpmnElement="Seta_1">
        <di:waypoint x="303" y="125" />
        <di:waypoint x="380" y="125" />
        <di:waypoint x="380" y="360" />
        <di:waypoint x="405" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_2_di" bpmnElement="Seta_2">
        <di:waypoint x="555" y="360" />
        <di:waypoint x="625" y="360" />
        <di:waypoint x="625" y="125" />
        <di:waypoint x="650" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_3_di" bpmnElement="Seta_3">
        <di:waypoint x="675" y="150" />
        <di:waypoint x="675" y="265" />
        <di:waypoint x="795" y="265" />
        <bpmndi:BPMNLabel><dc:Bounds x="683" y="245" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_4_di" bpmnElement="Seta_4">
        <di:waypoint x="675" y="150" />
