        <bpmndi:BPMNLabel><dc:Bounds x="1293" y="105" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_12_di" bpmnElement="Seta_12">
        <di:waypoint x="498" y="585" />
        <di:waypoint x="600" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_13_di" bpmnElement="Seta_13">
        <di:waypoint x="750" y="585" />
        <di:waypoint x="852" y="585" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
