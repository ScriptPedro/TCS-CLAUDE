        <di:waypoint x="795" y="455" />
        <bpmndi:BPMNLabel><dc:Bounds x="683" y="435" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_6_di" bpmnElement="Seta_6">
        <di:waypoint x="945" y="265" />
        <di:waypoint x="1065" y="265" />
        <di:waypoint x="1065" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_7_di" bpmnElement="Seta_7">
        <di:waypoint x="945" y="360" />
        <di:waypoint x="1040" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_8_di" bpmnElement="Seta_8">
        <di:waypoint x="945" y="455" />
        <di:waypoint x="1065" y="455" />
        <di:waypoint x="1065" y="385" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_9_di" bpmnElement="Seta_9">
        <di:waypoint x="1090" y="360" />
        <di:waypoint x="1210" y="360" />
        <di:waypoint x="1210" y="125" />
        <di:waypoint x="1235" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_10_di" bpmnElement="Seta_10">
        <di:waypoint x="1260" y="100" />
        <di:waypoint x="1260" y="75" />
        <di:waypoint x="675" y="75" />
        <di:waypoint x="675" y="100" />
        <bpmndi:BPMNLabel><dc:Bounds x="1266" y="78" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_11_di" bpmnElement="Seta_11">
        <di:waypoint x="1285" y="125" />
