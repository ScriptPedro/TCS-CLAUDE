        <di:waypoint x="795" y="360" />
        <bpmndi:BPMNLabel><dc:Bounds x="683" y="340" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Seta_5_di" bpmnElement="Seta_5">
        <di:waypoint x="675" y="150" />
