# Dados (grandes e sujeitos às regras da competição — não versionar)
data/raw/*
data/processed/*
!data/**/.gitkeep
# Banco de usuários (D40): tem dados pessoais (CPF, e-mail) — nunca versionar
*.db
*.db-journal

# Modelos treinados
models/*
!models/.gitkeep

# Credenciais
kaggle.json
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ipynb_checkpoints/

# Configuração local do editor/assistente
.claude/*
!.claude/settings.json
!.claude/hooks/

# Terraform (estado e variáveis locais podem conter dados da conta)
infra/*/.terraform/
infra/*/*.tfstate
infra/*/*.tfstate.*
infra/*/terraform.tfvars
infra/*/*.tfplan
